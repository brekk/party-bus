import type { Comparison } from "Compare"

import type { Tag } from "@/Tag"

import { EQ, GT, LT, gt, lt } from "Compare"
import Fn from "Function"
import { complement, equals } from "Function"
import List from "List"
import { fromMaybe } from "Maybe"
import String from "String"

import { Tag, tag, tagWithScope } from "@/Tag"
import { NoScope, compareScopes, scopeFromList, scopeWithinScope } from "@/Tag/Scope"



export type Query = AnyTag | NoTag | Not(Tag) | Exact(Tag)


compareSubScopes = (aName, aScope, aNeg, bName, bScope, bNeg) => {
  // if they share the same name
  return if (aName == bName) do {
    // higher nested scope is higher
    comp = compareScopes(aScope, bScope)
    return if (aNeg && !bNeg) {
      if (comp == LT) {
        GT
      } else if (comp == GT) {
        LT
      } else {
        EQ
      }
    } else {
      comp
    }
  } else {
    aName < bName ? LT : GT
  }
}

compareQuery :: Query -> Query -> Comparison
export compareQuery = (a, b) => where(#[a, b]) {
  #[NoTag, _] =>
    LT

  #[_, NoTag] =>
    GT

  #[AnyTag, _] =>
    GT

  #[_, AnyTag] =>
    LT

  // two tags with the same value are equal
  // otherwise, the second is less
  #[Exact(Tag(aName, NoScope)), Exact(Tag(bName, NoScope))] =>
    aName == bName ? EQ : aName < bName ? LT : GT

  #[Exact(Tag(aName, aScope)), Exact(Tag(bName, bScope))] =>
    compareSubScopes(aName, aScope, false, bName, bScope, false)

  // we only care if the names match and one is negated

  #[Exact(Tag(aName, aScope)), Not(Tag(bName, bScope))] =>
    compareSubScopes(aName, aScope, false, bName, bScope, true)

  #[Not(Tag(aName, aScope)), Exact(Tag(bName, bScope))] =>
    compareSubScopes(aName, aScope, true, bName, bScope, false)

  #[Not(Tag(aName, aScope)), Not(Tag(bName, bScope))] =>
    compareSubScopes(aName, aScope, false, bName, bScope, false)
}
instance Comparable Query {
  compare = compareQuery
}


// SUGAR

exact :: String -> Query
export exact = pipe(
  tag,
  Exact,
)

exactWithScope :: String -> List String -> Query
export exactWithScope = (t, sc) => pipe(
  tagWithScope(t),
  Exact,
)(sc)

not :: String -> Query
export not = pipe(
  tag,
  Not,
)

notWithScope :: String -> List String -> Query
export notWithScope = (t, sc) => pipe(
  tagWithScope(t),
  Not,
)(sc)

_firstAsString :: List String -> String
_firstAsString = pipe(
  List.first,
  fromMaybe(""),
)

fromString :: String -> Query
export fromString = (_part) => if (_part == "*") {
  AnyTag
} else if (_part == "") {
  NoTag
} else do {
  pos = String.startsWith("-", _part)
  part = if (pos) {
    String.drop(1, _part)
  } else {
    _part
  }
  return pipe(
    String.trim,
    String.split(":"),
    List.reject(equals("")),
    (list) => {
      listLen = List.length(list)
      seg = listLen == 1 ? [] : List.tail(list)
      return pipe(
        _firstAsString,
        Tag($, scopeFromList(seg)),
        pos ? Not : Exact,
      )(list)
    },
  )(part)
}



manyFromString :: String -> List Query
export manyFromString = pipe(
  String.split(","),
  List.reject(equals("")),
  map(fromString),
  List.reject(equals(NoTag)),
)

isNegated :: Query -> Boolean
export isNegated = where {
  Not(_) =>
    true

  _ =>
    false
}

isWild :: Query -> Boolean
export isWild = where {
  AnyTag =>
    true

  _ =>
    false
}

import IO from "IO"



anyTagMatches :: List Query -> Query -> Boolean
export anyTagMatches = (xs, t) => if (t == AnyTag) {
  true
} else do {
  under = pipe(
    List.filter(lt($, t)),
  )(xs)
  noneUnderIndex = pipe(
    List.isEmpty,
  )(under)
  over = pipe(
    List.filter(Fn.either(gt($, t), Fn.equals(t))),
  )(xs)
  someOverIndex = pipe(
    complement(List.isEmpty),
  )(over)
  return if (someOverIndex || noneUnderIndex) do {
    matches = List.any((o) => List.any(lt($, o), over))(under)

    return matches || someOverIndex && noneUnderIndex
  } else {
    someOverIndex && noneUnderIndex
  }
}

// we need to aggregate results across things?
checkEnvironment :: List Query -> Tag -> Boolean
export checkEnvironment = (legend, t) => {
  return anyTagMatches(legend, Exact(t))
}
