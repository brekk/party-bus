import type { DateTime } from "Date"
import type { Wish } from "Wish"

import type { Tag } from "freitag/Tag"

import Date from "Date"
import { append } from "List"

import { Tag } from "freitag/Tag"



export type PartyEvent a = PartyEvent(DateTime, Tag, String, a)
export alias Pile = { get :: {} -> List b, send :: Tag -> String -> a }
// lazyWithConfig :: Config -> Pile
export lazyWithConfig = (conf) => {
  pile = []
  return where(conf) {
    { decorate, effect, check, change } =>
      (
        {
          send: (tag, message, x) => do {
            msg = decorate(tag, message, x)
            return if (check(tag, msg, x)) do {
              pile := append(PartyEvent(Date.now(), tag, msg, x), pile)
              return x
            } else {
              x
            }
          },
          get: () => map(where { PartyEvent(time, tag, msg, x) => effect(msg, x) }, pile),
        }
      )
  }
}
