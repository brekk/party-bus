import type { TagQuery } from "freitag"

import Dict from "Dictionary"
import List from "List"
import { fromMaybe, isJust } from "Maybe"

import Tagged from "freitag"



getEnvWithKey :: String -> Dictionary String String -> List TagQuery
export getEnvWithKey = (key, env) => pipe(
  Dict.get(key),
  map(Tagged.fromString),
  fromMaybe([]),
  List.filter(isJust),
  map(fromMaybe(Tagged.NoTags)),
)(env)
