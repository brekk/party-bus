import { EQ, GT, LT } from "Compare"
import IO from "IO"
import List from "List"

import Freitag from "freitag"
import F from "freitag/Tag"

import PB from "@/PartyBus"



export main = () => {
  legend = [
    Freitag._createExact(["weather"]),
    Freitag._createExact(["sunlight"]),
    Freitag.InvertQuery(F.Tag(["weather", "sunny"])),
    Freitag.InvertQuery(F.Tag(["mouse", "scent"])),
    Freitag._createExact(["plant"]),
    Freitag.InvertQuery(F.Tag(["plant", "biology"])),
    Freitag._createExact(["biology", "spore"]),
    Freitag._createExact(["mouse"]),
    Freitag.InvertQuery(F.Tag(["wolf", "urine"])),
    Freitag._createExact(["cunning"]),
    Freitag._createExact(["fox"]),
    Freitag.InvertQuery(F.Tag(["wolf"])),
    Freitag._createExact(["hunger"]),
  ]
  pipe(
    IO.pTrace("### would this tag"),
    PB.checkEnvironment(legend),
    IO.pTrace("### get run?"),
  )(F.Tag(["fox", "cunning"]))
}
