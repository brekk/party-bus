import File from "File"
import FilePath from "FilePath"
import List from "List"
import Wish from "Wish"



#- import fs from "node:fs" -#
alias Pourable = { end :: {} -> {}, write :: String -> {} }
createSink :: String -> Pourable
export createSink = (f) => {
  x = #- fs.createWriteStream(f, {flags: 'a'}) -#
  write = (w) => #- x.write(w + "\n") -#
  end = () => #- x.end("\n") -#
  return { write, end }
}
export shout = (x, s) => {
  sink = createSink(x)
  sink.write(s)
  sink.end()
}
export barrage = (x, ts) => {
  sink = createSink(x)
  List.forEach(sink.write, ts)
  sink.end()
}
