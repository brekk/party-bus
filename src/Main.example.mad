import Printer from "Json/Print"

import Fn from "Function"
import {} from "Json"
import Parser from "Json/Parse"
import List from "List"
import Maybe from "Maybe"
import String from "String"

import Party from "@/PartyBus"
import PartyCabinet from "@/PartyCabinet"



export tags = {
  pizzeria: Party.tag("pizzeria"),
  register: Party.tagWithScope("pizzeria", ["register"]),
  registerDetail: Party.tagWithScope("pizzeria", ["register", "detail"]),
  menu: Party.tagWithScope("pizzeria", ["menu"]),
  menuSpecial: Party.tagWithScope("pizzeria", ["menu", "special"]),
  menuOutage: Party.tagWithScope(
    "pizzeria",
    [
      "menu",
      "outage",
    // export env = {
    ],
  ),
}
pizzeria = Party.env(tags.pizzeria)
pizzeriaJson = PartyCabinet.env(tags.pizzeria)
//// CONVERT OUR PIZZA TYPES TO AND FROM JSON

// we're encoding our constructor name as "tag" fields in JSON
singletonToTaggedJson = (t) => Printer.object([
  #[
    "tag",
    pipe(
      show,
      Printer.string,
    )(t),
  ],
])
// }
type PepperKind = Habanero | Bell | Anaheim | Thai
instance Scan PepperKind {
  scan = pipe(
    String.toLower,
    (x) => if (x == "habanero") {
      of(Habanero)
    } else if (x == "bell") {
      of(Bell)
    } else if (x == "anaheim") {
      of(Anaheim)
    } else if (x == "thai") {
      of(Thai)
    } else {
      Maybe.Nothing
    },
  )
}
pepperFromTag = pipe(
  scan,
  map(Parser.succeed),
  Maybe.fromMaybe(Parser.fail("Unknown Pepper")),
)
taggedFromJson = (construct) => pipe(
  Parser.field("tag"),
  chain(construct),
)(Parser.string)
instance Json PepperKind {
  fromJson = taggedFromJson(pepperFromTag)

  toJson = singletonToTaggedJson
}
type CheeseKind = Mozzarella | Jack | Cheddar | Feta
instance Scan CheeseKind {
  scan = pipe(
    String.toLower,
    (x) => if (x == "jack") {
      of(Jack)
    } else if (x == "cheddar") {
      of(Cheddar)
    } else if (x == "feta") {
      of(Feta)
    } else if (x == "mozzarella") {
      of(Mozzarella)
    } else {
      Maybe.Nothing
    },
  )
}
cheeseFromTag = pipe(
  scan,
  map(Parser.succeed),
  Maybe.fromMaybe(Parser.fail("Unknown Cheese")),
)
instance Json CheeseKind {
  fromJson = taggedFromJson(cheeseFromTag)

  toJson = singletonToTaggedJson
}
type Ingredient
  = Pepperoni
  | Cheese(CheeseKind)
  | Pepper(PepperKind)
  | Onion
  | Sausage
  | Chicken
  | Corn
  | Potato
  | Bacon
  | Tomato
  | Garlic
hasParens = Fn.both(String.match("\\("), String.endsWith(")"))
instance Scan Ingredient {
  scan = pipe(
    String.toLower,
    (x) => if (String.startsWith("cheese", x)) {
      if (hasParens(x)) {
        pipe(
          String.dropLast(1),
          scan,
        )(x)
      } else {
        of(Cheese(Mozzarella))
      }
    } else if (x == "pepperoni") {
      of(Pepperoni)
    } else if (String.startsWith("pepper", x) && !String.match("pepperoni", x)) {
      if (hasParens(x)) {
        pipe(
          String.dropLast(1),
          scan,
        )(x)
      } else {
        of(Pepper(Habanero))
      }
    } else if (x == "onion") {
      of(Onion)
    } else if (x == "sausage") {
      of(Sausage)
    } else if (x == "chicken") {
      of(Chicken)
    } else if (x == "corn") {
      of(Corn)
    } else if (x == "tomato") {
      of(Tomato)
    } else if (x == "potato") {
      of(Potato)
    } else if (x == "bacon") {
      of(Bacon)
    } else if (x == "garlic") {
      of(Garlic)
    } else {
      Maybe.Nothing
    },
  )
}
ingredientFromTag = (x) => if (x == "Cheese") {
  Parser.map1(Cheese, Parser.field("kind", fromJson))
} else if (x == "Pepper") {
  Parser.map1(Pepper, Parser.field("kind", fromJson))
} else {
  pipe(
    scan,
    map(Parser.succeed),
    Maybe.fromMaybe(Parser.fail("Unknown ingredient")),
  )(x)
}
instance Json Ingredient {
  fromJson = taggedFromJson(ingredientFromTag)

  toJson = (t) => where(t) {
    Cheese(k) =>
      Printer.object([#["tag", Printer.string("Cheese")], #["kind", singletonToTaggedJson(k)]])

    Pepper(k) =>
      Printer.object([#["tag", Printer.string("Pepper")], #["kind", singletonToTaggedJson(k)]])

    _ =>
      singletonToTaggedJson(t)
  }
}
type Pizza = Pizza(String, Float, List Ingredient)
instance Json Pizza {
  fromJson = pizzaParser

  toJson = pizzaToJson
}
// squad goals
pizzaParser = Parser.map3(
  Pizza,
  Parser.field("name", fromJson),
  Parser.field("cost", fromJson),
  Parser.field("ingredients", fromJson),
)
name = where {
  Pizza(n, _, _) =>
    n
}
price = where {
  Pizza(_, p, _) =>
    p
}
ingredients = where {
  Pizza(_, _, i) =>
    i
}
pizzaToJson = (x) => Printer.object([
  #[
    "name",
    pipe(
      name,
      Printer.string,
    )(x),
  ],
  #[
    "age",
    pipe(
      price,
      Printer.float,
    )(x),
  ],
  #[
    "ingredients",
    pipe(
      ingredients,
      Printer.list(toJson),
    )(x),
  ],
])
