// import { report } from "Study"
import Fn from "Function"
import IO from "IO"
import List from "List"
import String from "String"

import Study from "Study"
import Dye from "dye"
import FTag from "freitag/Tag"

import Config from "@/Configuration"
import Decorator from "@/Decorator"
import PB from "@/PartyBus"
import Predicate from "@/Predicate"



tag = pipe(
  of,
  FTag.create,
)
Study.report(
  Study.caseN3(Predicate.always),
  "always",
  [#[#[tag("unimportant"), "nothing", true], true]],
)
Study.report(
  Config.configurate(Decorator.none, IO.pTrace, Fn.identity),
  "configurate",
  [#[Predicate.always, Config.DEFAULT_CONFIG]],
)
Study.report(
  Study.caseN4(Decorator.none),
  "decorateRaw",
  [#[#["party-bus", tag("yo"), "cool", "blah"], "cool"]],
)
Study.report(
  pipe(
    tag,
    Decorator.withColor("party-bus", $, "yo", "blah"),
    Dye.stripAnsi,
    String.trim,
  ),
  "withColor",
  [#["silly", "silly  yo"]],
)
skipDateInStyledString = pipe(
  Dye.stripAnsi,
  String.split(" "),
  map(String.toList),
  // we skip the third index because time is hard to test
  (raw) => List.concat(List.slice(0, 2, raw), List.slice(4, 5, raw)),
  map(String.fromList),
  String.unwords,
)
Study.report(
  pipe(
    Decorator.withColorAndDate("party-bus", tag("hey"), "yo"),
    skipDateInStyledString,
  ),
  "decorateWithStyleAndDate",
  [#["blah", " hey " ++ Decorator.SPACE_ARROW ++ "yo"]],
)
skipDateInUnstyledString = pipe(
  String.words,
  List.takeLast(1),
  String.unwords,
)
Study.report(
  pipe(
    Decorator.withDate("party-bus", tag("hey"), $, "blah"),
    skipDateInUnstyledString,
  ),
  "decorateWithDate",
  [#["yo", "yo"]],
)
binaryIdentity = (_, b) => b
MY_CONF = {
  seed: "party-bus",
  effect: binaryIdentity,
  decorate: Config.STYLED_CONFIG.decorate,
  change: Config.STYLED_CONFIG.change,
  check: Config.STYLED_CONFIG.check,
}
Study.report(
  PB.signalWithConfig(MY_CONF, tag("yo"), "blah"),
  "STYLED_CONFIG-ish / taggedSignal-ish",
  [#["raw", "raw"]],
)
Study.report(
  PB.signal(tag("yo"), "blah"),
  "STYLED_CONFIG-ish / taggedSignal-ish",
  [#["raw", "raw"]],
)
customTestConfig = pipe(
  Config.setSeed("ahoy"),
  Config.setDecorator(Decorator.none),
  Config.setChange((_) => "x"),
)(Config.DEFAULT_CONFIG)
Study.report(
  Study.caseN4(customTestConfig.decorate),
  "decorate",
  [#[#["ahoy", tag("a"), "b", "c"], "b"]],
)
