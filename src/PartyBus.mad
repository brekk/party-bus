import type { PartyBusConfig } from "@/Configuration"

import List from "List"
import Maybe from "Maybe"
import Process from "Process"
import String from "String"

import Freitag from "freitag"
import Tag from "freitag/Tag"

import Config from "@/Configuration"
import Env from "@/Env"
import Predicate from "@/Predicate"



// sugar atop Freitag
export tag = pipe(
  of,
  Tag.create,
)
export tagWithScope = (a, bs) => Tag.create([a, ...bs])
export createTags = (key) => map(tagWithScope(key))
export alias Signal a = Tag -> String -> a -> a
export alias SideEffect a = String -> a -> a
export tap = (spout, msg, taproot, x) => {
  spout(msg, taproot(x))
  return x
}
///////// The main thing that PartyBus offers, in a tiny form
signalWithConfig :: Show a => PartyBusConfig a b -> Signal a
export signalWithConfig = ({ seed, decorate, effect, check, change }, tg, message, x) => (
  !check(tg, message, x) ? x : tap(effect, decorate(seed, tg, message, x), change, x)
)
signal :: Show a => Tag -> String -> a -> a
export signal = signalWithConfig(Config.DEFAULT_CONFIG)
export dateTaggedSignal = signalWithConfig(Config.STYLED_CONFIG)
partyBus :: Show a => List Freitag.TagQuery -> PartyBusConfig a b -> Tag -> String -> a -> a
export partyBus = (legend, config) => pipe(
  Config.setCheck(Predicate.checkAgainstEnvironmentAlso(config.check, legend)),
  signalWithConfig,
)(config)
envFrom :: Show a => Dictionary String String
  -> #[String, String]
  -> PartyBusConfig a b
  -> Tag
  -> String
  -> a
  -> a
export envFrom = (envDict, #[key, _]) => partyBus(Env.getEnvWithKey(key, envDict))
keyedEnv :: Show a => #[String, String] -> PartyBusConfig a b -> Tag -> String -> a -> a
export keyedEnv = envFrom(Process.Env)
export ENV_VARS = #["DEBUG", "DEBUG_LOG"]
bus :: Show a => PartyBusConfig a b -> Tag -> String -> a -> a
export bus = keyedEnv(ENV_VARS)
env :: Show a => Tag -> String -> a -> a
export env = bus(Config.STYLED_CONFIG)
