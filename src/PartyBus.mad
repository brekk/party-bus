export type StreamMode = EagerStream | LazyStream
export type FlushMode = EagerFlush | LazyFlush
/**
 * The configuration of the signal
 * @since 0.0.1
 */
export alias Config = {
  change :: a -> b,
  check :: PartyPredicate a,
  decorate :: Decorator a,
  effect :: SideEffect b,
  flushMode :: FlushMode,
  seed :: String,
  streamMode :: StreamMode,
}
/**
 * The condition of when a side-effect should run
 * @since 0.0.1
 */
export alias PartyPredicate a = Tag -> String -> a -> Boolean
/**
 * The message decoration
 * @since 0.0.1
 */
export alias Decorator a = String -> Tag -> String -> a -> String
export alias Signal a = Tag -> String -> a -> a
/**
 * The core function that does all the magic of PartyBus.
 * Conditionally call a side-effect with a specific tag, message and value.
 * @since 0.0.1
 */
signalWithConfig :: Config -> Signal a
export signalWithConfig = (conf, tg, message, x) => {
  return where(conf) {
    { seed, decorate, effect, change, check } =>
      do {
        msg = decorate(seed, tg, message, x)
        return if (check(tg, msg, x)) do {
          effect(msg, change(x))
          return x
        } else {
          x
        }
      }
  }
}
/**
 * A shorthand function to always fire the side-effect
 * @since 0.0.1
 */
always :: PartyPredicate a
export always = (_, _, _) => true
/**
 * A shorthand function to pass the message unchanged
 * @since 0.0.1
 */
decorateRaw :: Decorator a
export decorateRaw = (_, _, m, _) => m
serialize = pipe(
  Tag.toList,
  String.join(":"),
)
/**
 * A means of colorizing a message by tag
 * @since 0.0.1
 */
colorizeTag :: String -> Tag -> String
export colorizeTag = (seed, x) => pipe(
  serialize,
  (tagId) => colorize(seed, " " ++ tagId ++ " "),
)(x)
/**
 * Color by tag and prepend to message
 * @since 0.0.1
 */
decorateWithStyle :: Decorator a
export decorateWithStyle = (seed, tg, message, _) => {
  idWithColor = colorizeTag(seed, tg)
  return idWithColor ++ " " ++ message
}
/**
 * Color by tag, add current time and prepend to message
 * @since 0.0.1
 */
decorateWithStyleAndDate :: Decorator a
export decorateWithStyleAndDate = (seed, tg, message, _) => {
  idWithColor = colorizeTag(seed, tg)
  return idWithColor ++ " " ++ toISOString(now()) ++ " ▸ " ++ message
}
decorateWithDate :: Decorator a
export decorateWithDate = (_, tg, message, _) => {
  return serialize(tg) ++ " " ++ toISOString(now()) ++ " ▸ " ++ message
}
// (this currently has an issue w/r/t partial application - it works but not as well as it should)
/**
 * A sugar method to create a Config record, usually by partial application 
 * @since 0.0.1
 */
configurateWithSeedAndStreamConfig :: StreamMode
  -> FlushMode
  -> String
  -> Decorator a
  -> SideEffect b
  -> (a -> b)
  -> PartyPredicate a
  -> Config
export configurateWithSeedAndStreamConfig = (
  streamMode,
  flushMode,
  seed,
  decorate,
  effect,
  change,
  check
) => ({ streamMode, flushMode, seed, decorate, effect, change, check })
export configurateWithSeed = configurateWithSeedAndStreamConfig(EagerStream, EagerFlush)
export configurate = configurateWithSeed("party-bus")
export confSeed = (seed, ext) => ({ ...ext, seed })
export confDecorator = (decorator, ext) => ({ ...ext, decorator })
export confEffect = (effect, ext) => ({ ...ext, effect })
export confChange = (change, ext) => ({ ...ext, change })
export confCheck = (check, ext) => ({ ...ext, check })
export confFlushMode = (flushMode, ext) => ({ ...ext, flushMode })
export confStreamMode = (streamMode, ext) => ({ ...ext, streamMode })
/**
 * The default config to use when invoking the bus, shorthand for:
 * Call IO.pTrace unconditionally, with no change to the value passing through. 
 * @since 0.0.1
 */
DEFAULT_CONFIG :: Show a => Config
export DEFAULT_CONFIG = {
  seed: "party-bus",
  decorate: decorateRaw,
  check: always,
  effect: IO.pTrace,
  change: identity,
  flushMode: EagerFlush,
  streamMode: EagerStream,
}
// we don't test this because it's wired to IO
/**
 * signalWithConfig minus the config
 * @since 0.0.1
 */
signal :: Show a => Tag -> String -> a -> a
export signal = signalWithConfig(DEFAULT_CONFIG)
/**
 * An alternative config based on the default config with a styled decorator
 * @since 0.0.1
 */
export STYLED_CONFIG = {
  seed: "party-bus",
  decorate: decorateWithStyle,
  effect: IO.pTrace,
  change: identity,
  check: always,
  flushMode: EagerFlush,
  streamMode: EagerStream,
}
// we don't test this because it's wired to IO
/**
 * Call signal with a colorized serialized tag prepended to the message
 * @since 0.0.1
 */
export taggedSignal = signalWithConfig(STYLED_CONFIG)
/**
 * An alternative config based on the default config with a styled and dated config
 * @since 0.0.1
 */
export DATED_CONFIG = {
  seed: "party-bus",
  decorate: decorateWithStyleAndDate,
  effect: IO.pTrace,
  change: identity,
  check: always,
  flushMode: EagerFlush,
  streamMode: EagerStream,
}
/**
 * Call signal with a colorized serialized tag and date prepended to the message
 * @since 0.0.1
 */
export dateTaggedSignal = signalWithConfig(DATED_CONFIG)
export DISCRETE_FILE_CONFIG = {
  seed: "party-bus",
  decorate: decorateWithDate,
  effect: IO.pTrace,
  change: identity,
  check: always,
  flushMode: EagerFlush,
  streamMode: EagerStream,
}
/**
 * Call signal with our discrete file config
 * @since 0.0.1
 */
export fileBackedSignal = signalWithConfig(DISCRETE_FILE_CONFIG)
checkEnvironment :: List TagQuery -> Tag -> Boolean
export checkEnvironment = (queries, tg) => pipe(
  List.find(Freitag.tagApplies(tg)),
  map(Freitag.queryAppliesTo),
  fromMaybe(false),
)(queries)
/**
 * signalWithConfig, but wired to a list of queries
 * @since 0.0.1
 */
partyBus :: List TagQuery -> Config -> Tag -> String -> a -> a
export partyBus = (legend, config, t, msg, x) => signalWithConfig(
  confCheck(
    (_tag, _msg, _x) => checkEnvironment(legend, _tag) && config.check(_tag, _msg, _x),
    config,
  ),
  t,
  msg,
  x,
)
/**
 * partyBus, but wired to a dictionary of string keys to parse
 * @since 0.0.1
 */
envFrom :: Dictionary String String -> String -> Config -> Tag -> String -> a -> a
export envFrom = (envDict, key, config, t, msg, x) => partyBus(
  getEnvWithKey(key, envDict),
  config,
  t,
  msg,
  x,
)
/**
 * convenient shortcut to call Freitag's Tag.create
 * @since 0.3.0
 */
export tag = pipe(
  of,
  FTag.create,
)
/**
 * convenient shortcut to call Freitag's Tag.create with an extended scope
 * @since 0.3.0
 */
export tagWithScope = (a, bs) => FTag.create([
  a,
  ...bs,
/**
 * Create multiple tags with different scopes but the same base
 * @since 0.0.4
 */
])
export createTags = (key, scopes) => pipe(
  map(tagWithScope(key)),
)(scopes)
/**
 * "Push" a new base onto an existing tag,
 * converting the extant base to the beginning of the scope
 * @since 0.0.5
 */
pushTag :: String -> Tag -> Tag
export pushTag = (parent, t) => where(t) {
  FTag.Tag(raw) =>
    FTag.create([parent, ...raw])

  _ =>
    t
}
// The following functions are untested because they rely upon Process.Env, which we can't guarantee from the test environment
/**
 * partyBus, but wired to the environment
 * @since 0.0.1
 */
keyedEnv :: String -> Config -> Tag -> String -> a -> a
export keyedEnv = envFrom(Process.Env)
/**
 * partyBus, but wired to the DEBUG value from the environment
 * @since 0.0.1
 */
bus :: Config -> Tag -> String -> a -> a
export bus = keyedEnv("DEBUG")
/**
 * partyBus, but wired to the DEBUG value with the styled
 * and dated config
 * @since 0.0.1
 */
env :: Show a => Tag -> String -> a -> a
export env = bus(DATED_CONFIG)
/**
 * generic tap function, which allows you to specify a lambda for an ephemeral (non-mutating) / lens-like transformation at call time
 */
tap :: (String -> b -> b) -> String -> (a -> b) -> a -> a
export tap = (spout, msg, taproot, x) => {
  spout(msg, taproot(x))
  return x
}
