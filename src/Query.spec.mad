import { EQ, GT, LT } from "Compare"

import { caseN2, report } from "Study"

import {
  AnyTag,
  Exact,
  NoTag,
  Not,
  anyTagMatches,
  checkEnvironment,
  compareQuery,
  exact,
  exactWithScope,
  fromString,
  isNegated,
  isWild,
  manyFromString,
  not,
  notWithScope,
} from "@/Query"
import { tag, tagWithScope } from "@/Tag"



report(
  fromString,
  "fromString",
  [
    #["", NoTag],
    #["*", AnyTag],
    #["hey", exact("hey")],
    #["alpha:beta:delta:gamma", exactWithScope("alpha", ["beta", "delta", "gamma"])],
    #["-alpha:beta:delta:gamma", notWithScope("alpha", ["beta", "delta", "gamma"])],
  ],
)
testCompareQuery = report(caseN2(compareQuery))

testCompareQuery("compareQuery - * is greater", [#[#[AnyTag, NoTag], GT], #[#[NoTag, AnyTag], LT]])
testCompareQuery(
  "compareQuery - NoTag is lesser",
  [#[#[exact("huh"), NoTag], GT], #[#[NoTag, exact("yes")], LT]],
)


testCompareQuery(
  "compareQuery - identical queries are equal",
  [
    #[#[exact("yo"), exact("yo")], EQ],
    #[#[exactWithScope("a", ["b", "c"]), exactWithScope("a", ["b", "c"])], EQ],
  ],
)
testCompareQuery(
  "compareQuery - two dissimilar queries compare base tags",
  [
    #[#[exact("yo"), exact("no")], GT],
    #[#[exact("no"), exact("yo")], LT],
    #[#[exactWithScope("a", ["b"]), exactWithScope("b", ["a"])], LT],
  ],
)
testCompareQuery(
  "compareQuery - same base comparisons",
  [
    #[#[exactWithScope("a", ["b"]), exactWithScope("a", ["b", "c"])], EQ],
    #[#[exactWithScope("a", ["b", "c"]), exactWithScope("a", ["b"])], EQ],
  ],
)
testCompareQuery(
  "compareQuery - negated scopes",
  [
    #[#[exactWithScope("a", ["b"]), not("a")], GT],
    #[#[exactWithScope("a", ["b"]), not("b")], LT],
    #[#[notWithScope("a", ["b"]), exact("a")], GT],
    #[#[notWithScope("a", ["b"]), exact("b")], LT],
    #[#[notWithScope("ortho", ["split"]), exactWithScope("ortho", ["split", "camel"])], EQ],
  ],
)
testCompareQuery(
  "compareQuery - NoTag",
  [#[#[exactWithScope("a", ["b"]), NoTag], GT], #[#[NoTag, exact("a")], LT]],
)


report(
  manyFromString,
  "manyFromString",
  [
    #["", []],
    #["a,b", [exact("a"), exact("b")]],
    #["a,b,c:d", [exact("a"), exact("b"), exactWithScope("c", ["d"])]],
    #["a,-b,c:d", [exact("a"), not("b"), exactWithScope("c", ["d"])]],
  ],
)

report(isNegated, "isNegated", [#[not("yo"), true], #[exact("yo"), false]])
report(isWild, "isWild", [#[AnyTag, true], #[exact("yo"), false]])

report(
  caseN2(anyTagMatches),
  "anyTagMatches",
  [
    #[#[[AnyTag], exact("blah")], true],
    #[#[[NoTag], exact("blah")], false],
    #[#[[exact("blah")], exact("blah")], true],
    #[#[[exactWithScope("blah", ["blah"])], exact("blah")], false],
    #[#[[notWithScope("blah", ["blah"])], exact("blah")], false],
  ],
)

report(
  caseN2(checkEnvironment),
  "checkEnvironment",
  [
    #[#[[AnyTag], tag("blah")], true],
    #[#[[NoTag], tag("blah")], false],
    #[#[[exact("blah")], tag("blah")], true],
    #[#[[exactWithScope("blah", ["blah"])], tag("blah")], false],
    #[#[[notWithScope("blah", ["blah"])], tag("blah")], false],
  ],
)

// we want to be able to include a broad selector
// but exclude a nested selector
// https://github.com/brekk/party-bus/issues/3

testAnyTagMatches = report(caseN2(anyTagMatches))
testAnyTagMatches(
  "anyTagMatches - issues/3 - ortho,-ortho:split will not print ortho:split:camel",
  [
    #[
      #[
        [exact("ortho"), notWithScope("ortho", ["split"])],
        exactWithScope("ortho", ["split", "camel"]),
      ],
      false,
    ],
  ],
)
testAnyTagMatches(
  "anyTagMatches - issues/3 - scorpion,-scorpion:thorax,spider,-scorpion:pedipalp:hair will print spider:pedipalp",
  [
    #[
      #[
        [
          exact("scorpion"),
          notWithScope("scorpion", ["thorax"]),
          exact("spider"),
          notWithScope("scorpion", ["pedipalp", "hair"]),
        ],
        exactWithScope("spider", ["pedipalp"]),
      ],
      true,
    ],
  ],
)
testAnyTagMatches(
  "anyTagMatches - issues/3 - scorpion,-scorpion:thorax,spider,-scorpion:pedipalp:hair will print spider:cool:dope:nice",
  [
    #[
      #[
        [
          exact("scorpion"),
          notWithScope("scorpion", ["thorax"]),
          exact("spider"),
          notWithScope("scorpion", ["pedipalp", "hair"]),
        ],
        exactWithScope("spider", ["cool", "dope", "nice"]),
      ],
      true,
    ],
  ],
)

testEnv = report(caseN2(checkEnvironment))

testEnv(
  "checkEnvironment - issues/3 - ortho,-ortho:split will not print ortho:split:camel",
  [
    #[
      #[
        [exact("ortho"), notWithScope("ortho", ["split"])],
        tagWithScope("ortho", ["split", "camel"]),
      ],
      false,
    ],
  ],
)
testEnv(
  "checkEnvironment - issues/3 - ortho,-ortho:split will not print ortho:split",
  [
    #[
      #[[exact("ortho"), notWithScope("ortho", ["split"])], tagWithScope("ortho", ["split"])],
      false,
    ],
  ],
)
testEnv(
  "checkEnvironment - issues/3 - ortho,-ortho:split will not print ortho:split:camel:detail",
  [
    #[
      #[
        [exact("ortho"), notWithScope("ortho", ["split"])],
        tagWithScope("ortho", ["split", "camel", "detail"]),
      ],
      false,
    ],
  ],
)
testEnv(
  "checkEnvironment - issues/3 - scorpion,-scorpion:split will print scorpion:a:different:route",
  [
    #[
      #[
        [exact("scorpion"), notWithScope("scorpion", ["split"])],
        tagWithScope("scorpion", ["a", "different", "route"]),
      ],
      true,
    ],
  ],
)
testEnv(
  "checkEnvironment - issues/3 - *,-scorpion:split will print scorpion:a:different:route",
  [
    #[
      #[
        [AnyTag, notWithScope("scorpion", ["split"])],
        tagWithScope("scorpion", ["a", "different", "route"]),
      ],
      true,
    ],
  ],
)
testEnv(
  "checkEnvironment - issues/3 - scorpion,-scorpion:split will print scorpion",
  [#[#[[exact("scorpion"), notWithScope("scorpion", ["split"])], tag("scorpion")], true]],
)
