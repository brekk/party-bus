import type { CommandResult } from "Process"

import Dir from "Directory"
import File from "File"
import Path from "FilePath"
import Fn from "Function"
import Wish from "Wish"

import Shroud from "shroud"

import Error from "@/Error"



writeFileWithRecursivePath :: Boolean -> String -> String -> Wish Error.PartyFoul String
export writeFileWithRecursivePath = (recursive, filePath, body) => pipe(
  Path.parentPath,
  Dir.create($, { recursive }),
  Wish.mapRej(Fn.always(Error.UnableToCreatePath)),
  chain(
    (_) => pipe(
      File.write(filePath),
      Wish.mapRej(Fn.always(Error.UnableToWriteFile)),
    )(body),
  ),
  map(Fn.always(body)),
)(filePath)
export writeFile = writeFileWithRecursivePath(true)
