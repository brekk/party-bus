import DateTime from "Date"
import Dict from "Dictionary"
import Fn from "Function"
import Print from "Json/Print"
import JV from "Json/Value"
import List from "List"
import Maybe from "Maybe"
import { Just } from "Maybe"
import Process from "Process"
import String from "String"

import Dye from "dye"
import Freitag from "freitag"
import Tag from "freitag/Tag"

import Env from "@/Env"
import _File from "@/File"
import PartyBus from "@/PartyBus"
import Pred from "@/Predicate"



export alias Serializer a = a -> JV.Value
export alias SerialConverter a = Tag -> String -> a -> JV.Value
export alias JsonEffect = JV.Value -> {}
export alias JsonConfig raw = {
  check :: Pred.PartyPredicate raw,
  convert :: SerialConverter raw,
  effect :: JsonEffect,
}
signalWithConfig :: JsonConfig a -> Tag -> String -> a -> a
export signalWithConfig = ({ convert, effect, check }, tg, message, x) => if (
  check(tg, message, x)
) do {
  effect(convert(tg, message, x))
  return x
} else {
  x
}
tagToJsonList :: Tag -> JV.Value
export tagToJsonList = pipe(
  Tag.toList,
  Print.list(Print.string),
)
jsonL :: Json a => Tag -> String -> a -> JV.Value
export jsonL = (tg, m, v) => Print.object([
  #[
    "timestamp",
    pipe(
      DateTime.toISOString,
      Print.string,
    )(DateTime.now()),
  ],
  #[
    "message",
    pipe(
      Dye.stripAnsi,
      Print.string,
    )(m),
  ],
  #["tag", tagToJsonList(tg)],
  #["value", toJson(v)],
])
// our primary effect, shouting values into a json file
// we need long ass lines as newlines aren't allowed in JSONL
jsonPrint :: String -> JV.Value -> {}
export jsonPrint = (logFile) => pipe(
  Print.printJson(100000000),
  _File.shout(logFile),
  Fn.always({}),
)
export writeToFileEffect = (ref) => {
  logFile = ref ?? ""
  return String.isEmpty(logFile) ? (_) => {} : jsonPrint(logFile)
}
// the analog to `partyBus` in `PartyBus.mad`
partyCabinet :: Json a => Maybe String
  -> List Freitag.TagQuery
  -> JsonConfig a
  -> Tag
  -> String
  -> a
  -> a
export partyCabinet = (logRef, legend, { check, convert }) => signalWithConfig({
  convert,
  check: Pred.checkAgainstEnvironmentAlso(check, legend),
  effect: writeToFileEffect(logRef),
})
envFrom :: Json a => Dictionary String String
  -> #[String, String]
  -> JsonConfig a
  -> Tag
  -> String
  -> a
  -> a
export envFrom = (envDict, #[key, fileHook]) => partyCabinet(
  Dict.get(fileHook, Process.Env),
  Env.getEnvWithKey(key, envDict),
)
keyedEnv :: Json a => #[String, String] -> JsonConfig a -> Tag -> String -> a -> a
export keyedEnv = envFrom(Process.Env)
DEFAULT_CONFIG :: Json a => JsonConfig a
export DEFAULT_CONFIG = { check: Pred.always, effect: (_) => {}, convert: jsonL }
bus :: Json a => JsonConfig a -> Tag -> String -> a -> a
export bus = keyedEnv(PartyBus.ENV_VARS)
export env = bus(DEFAULT_CONFIG)
