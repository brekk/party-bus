// import { report } from "Study"
import Fn from "Function"
import IO from "IO"
import List from "List"
import String from "String"
import { assertEquals, test } from "Test"

import Dye from "dye"
import FTag from "freitag/Tag"

import Config from "@/Configuration"
import Decorator from "@/Decorator"
import { signalWithConfig } from "@/PartyBus"
import Predicate from "@/Predicate"



tag = pipe(
  of,
  FTag.create,
)
test("always", () => assertEquals(Predicate.always(tag("unimportant"), "nothing", true), true))
test(
  "configurate",
  () => do {
    return assertEquals(
      IO.pTrace(
        "RAW",
        Config.configurate(Decorator.none, IO.pTrace, Fn.identity, Predicate.always),
      ),
      Config.DEFAULT_CONFIG,
    )
  },
)
test(
  "decorateRaw",
  () => assertEquals(Decorator.none("party-bus", tag("yo"), "cool", "blah"), "cool"),
)
test(
  "withColor",
  () => assertEquals(
    pipe(
      Decorator.withColor("party-bus", $, "yo", "blah"),
      Dye.stripAnsi,
    )(tag("silly")),
    " silly  yo",
  ),
)
skipDateInStyledString = pipe(
  Dye.stripAnsi,
  String.split(" "),
  map(String.toList),
  // we skip the third index because time is hard to test
  (raw) => List.concat(List.slice(0, 2, raw), List.slice(4, 5, raw)),
  map(String.fromList),
  String.unwords,
)
test(
  "decorateWithStyleAndDate",
  () => assertEquals(
    pipe(
      Decorator.withColorAndDate("party-bus", tag("hey"), "yo"),
      skipDateInStyledString,
    )("blah"),
    " hey " ++ Decorator.SPACE_ARROW ++ "yo",
  ),
)
binaryIdentity = (_, b) => b
MY_CONF = {
  seed: "party-bus",
  effect: binaryIdentity,
  decorate: Config.STYLED_CONFIG.decorate,
  change: Config.STYLED_CONFIG.change,
  check: Config.STYLED_CONFIG.check,
}
test(
  "STYLED_CONFIG-ish / taggedSignal-ish",
  () => {
    return assertEquals(signalWithConfig(MY_CONF, tag("yo"), "blah", "raw"), "raw")
  },
)
test(
  "DEFAULT_CONFIG-ish / signal-ish",
  () => do {
    return assertEquals(
      pipe(
        signalWithConfig(MY_CONF, tag("yo"), "blah"),
      )("raw"),
      "raw",
    )
  },
)
test(
  "confDecorator + confChange + confSeed",
  () => do {
    conf = pipe(
      Config.setSeed("ahoy"),
      Config.setDecorator(Decorator.none),
      Config.setChange((_) => "x"),
    )(Config.DEFAULT_CONFIG)
    _ <- assertEquals(conf.decorate("ahoy", tag("a"), "b", "c"), "b")
    return assertEquals(conf.change("hello?"), "x")
  },
)
