import { caseN3, report } from "Study"
import { create } from "freitag/Tag"

import { confEffect } from "@/Core"
import { STYLED_CONFIG, createTags, envFrom, pushTag, tag, tagWithScope } from "@/PartyBus"



createTag = create
TEST_ENV = {{ "DEBUG": "test:scope:detail,check,-nice" }}
report(tag, "tag", [#["one", create(["one"])]])
report(tagWithScope("one"), "tagWithScope", [#[["two"], create(["one", "two"])]])
report(
  caseN3(envFrom(TEST_ENV, "DEBUG", confEffect((_, x) => x, STYLED_CONFIG))),
  "partyBus",
  [
    #[#[createTag(["check"]), "message!", "raw"], "raw"],
    #[#[createTag(["test", "scope", "detail"]), "message!", "raw"], "raw"],
    #[#[createTag(["nothing"]), "message!", "raw"], "raw"],
  ],
)
report(
  createTags("test"),
  "createTags",
  [
    #[
      [["info"], ["warn"], ["detail"], ["detail", "nested"]],
      [
        createTag(["test", "info"]),
        createTag(["test", "warn"]),
        createTag(["test", "detail"]),
        createTag(["test", "detail", "nested"]),
      ],
    ],
  ],
)
report(
  createTags("test"),
  "createTags - Dictionary",
  [
    #[
      {{
        "info": ["info"],
        "warn": ["warn"],
        "detail": ["detail"],
        "detailNested": ["detail", "nested"],
      }},
      {{
        "info": createTag(["test", "info"]),
        "warn": createTag(["test", "warn"]),
        "detail": createTag(["test", "detail"]),
        "detailNested": createTag(["test", "detail", "nested"]),
      }},
    ],
  ],
)
report(
  pushTag("test"),
  "pushTag",
  [
    #[createTag(["hey"]), createTag(["test", "hey"])],
    #[createTag(["hey", "there"]), createTag(["test", "hey", "there"])],
  ],
)
